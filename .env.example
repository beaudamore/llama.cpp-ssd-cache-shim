# ssd-cache-shim configuration. Copy to .env next to ssd_cache_shim.py (or pass --env PATH).
# Real environment variables with the same names override these values. Full reference: docs/configuration.md

# Where clients (Open WebUI, Hermes, ...) connect. Point them at http://<host>:LISTEN_PORT/v1
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8090

# The llama-server this shim fronts (one shim per llama-server).
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=8080
# Only if llama-server runs with --api-key; used for the shim's own /slots and /props calls.
UPSTREAM_API_KEY=

# Directory holding the saved slot files. MUST be the same directory given to llama-server as --slot-save-path.
# The shim owns this directory: any .bin in it that is not in its index is deleted. Put it on the SSD.
#   Windows:  C:\llama-slot-cache          macOS:  /Users/you/llama-slot-cache        Linux:  /var/cache/llama-slots
SLOT_SAVE_DIR=/path/to/llama-slot-cache

# Request headers the shim reads. In Open WebUI: Admin > Settings > Connections > (this connection) > Headers:
#   X-OpenWebUI-Chat-Id = {{CHAT_ID}}     X-OpenWebUI-Task = {{TASK}}
# See docs/openwebui.md. Other clients can send the same headers or rely on the hash fallback below.
CHAT_ID_HEADER=X-OpenWebUI-Chat-Id
TASK_HEADER=X-OpenWebUI-Task

# Clients that send no chat id are keyed by a hash of system prompt + first user turn.
# true = save those conversations to SSD too (aged out by MAX_AGE_DAYS only, since no Open WebUI check applies).
PERSIST_FALLBACK=true

# Reserve slots for particular model ids: "model:slot" pairs, comma separated (empty = no reservation). A listed model uses only its
# slot(s); every other model never touches them. Needed when a proxy between this shim and llama-server turns a model id into a
# per-request LoRA adapter: llama-server clears a slot's cache whenever the adapter set on that slot changes, which would also wipe a
# state this shim had just restored into it. Keep each adapter on its own slot and the problem never arises. See docs/llama-server.md.
#   MODEL_SLOTS=my-model-lora:2
MODEL_SLOTS=

# Save a dirty slot to SSD before another conversation takes it over (synchronous, one sequential write).
# false = rely on the idle save alone; a conversation evicted before its idle save is not on SSD.
SAVE_ON_EVICT=true
# Save a dirty slot once it has been idle this long, so later evictions find the file already current.
IDLE_SAVE_SECONDS=120

# SSD budget. Files are dropped when unused for MAX_AGE_DAYS, then least-recently-used until under MAX_BYTES.
MAX_AGE_DAYS=30
MAX_BYTES=50G

# Cleanup sweep: every N minutes inside the shim (0 = never; run `ssd_cache_shim.py --reconcile` from a scheduler instead).
RECONCILE_INTERVAL_MINUTES=60
# When set, the sweep asks Open WebUI whether each chat still exists (GET /api/v1/chats/{id}; 404 = delete the file).
# API key: Open WebUI > Settings > Account > API keys. The key's user must be able to read the chats (admin, or the only user).
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_API_KEY=

# debug | info | warn | error
LOG_LEVEL=info
